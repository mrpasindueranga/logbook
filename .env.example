PORT=3000

# Docker image versioning (image name should start with local-)
IMAGE_NAME=local-logbook-app
IMAGE_TAG=latest

# Script flags for scripts/build-push-deploy.sh
PUSH_IMAGE=false
DEPLOY_AFTER_BUILD=true
PUSH_LATEST=true

# Set this when running behind nginx under a sub-folder, e.g. /logbook
# Leave blank to serve from /
BASE_PATH=

# Directory where logbook.db is stored (created automatically)
DATA_DIR=./data

# Host path mounted into the dockerized MinIO container's /data (docker-compose.yml).
# Point this at an existing MinIO data directory to reuse its buckets/files.
MINIO_DATA_DIR=./data/minio
